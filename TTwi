  <!-- Native ES6+ Module Interaction Logic -->
  <script type="module">
    // Bind interaction logic adhering to Section 4 (no inline JS, addEventListener)
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Tab switching micro-interactions
      const tabForYou = document.getElementById('tabForYou');
      const tabFollowing = document.getElementById('tabFollowing');

      const selectTab = (activeTab, inactiveTab) => {
        activeTab.classList.add('tab-button--active');
        inactiveTab.classList.remove('tab-button--active');
      };

      if (tabForYou && tabFollowing) {
        tabForYou.addEventListener('click', () => selectTab(tabForYou, tabFollowing));
        tabFollowing.addEventListener('click', () => selectTab(tabFollowing, tabForYou));
      }

      // 2. Interactive Like buttons (Pure UI micro-interaction for testing)
      const likeButtons = document.querySelectorAll('.action-button--like');
      likeButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const countSpan = btn.querySelector('span');
          const isLiked = btn.classList.toggle('active');
          
          if (countSpan) {
            const currentCount = parseInt(countSpan.textContent, 10) || 0;
            countSpan.textContent = isLiked ? (currentCount + 1) : (currentCount - 1);
          }
        });
      });

      // 3. Navigation Bar Active States
      const navItems = document.querySelectorAll('.nav-item');
      navItems.forEach((item) => {
        item.addEventListener('click', () => {
          navItems.forEach((nav) => nav.classList.remove('nav-item--active'));
          item.classList.add('nav-item--active');
        });
      });

      // 4. Compose FAB Button Ripple feedback
      const composeBtn = document.getElementById('composeButton');
      if (composeBtn) {
        composeBtn.addEventListener('click', () => {
          console.log('[Liquid Glass UI] Compose FAB tapped - static view preview mode.');
        });
      }
    });
  </script>
