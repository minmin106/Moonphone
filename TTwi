    </header>

    <!-- Middle Tweet Stream -->
    <main class="feed-container" id="feedContainer">

      <!-- Tweet Card 1 (Liquid Glass AI Companion active status) -->
      <article class="glass-panel tweet-card">
        <div class="tweet-card__inner">
          <div class="tweet-avatar tweet-avatar--ai" aria-hidden="true">LG</div>
          <div class="tweet-content">
            <div class="tweet-header">
              <div class="tweet-author">
                <span class="tweet-name">Liquid Assistant</span>
                <span class="tweet-badge" title="Verified Assistant">
                  <svg viewBox="0 0 24 24" class="svg-icon" style="width: 14px; height: 14px;">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="currentColor"/>
                  </svg>
                </span>
                <span class="tweet-handle">@glass_ai</span>
                <span class="tweet-time">· 2m</span>
              </div>
              <button class="tweet-more-btn" aria-label="More options">
