<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Liquid Glass - Twitter</title>
  <style>
    /* ----------------------------------------------------
       3.1 CSS Variables (Mandatory tokens)
       ---------------------------------------------------- */
    :root {
      --glass-bg: rgba(255, 255, 255, 0.08);
      --glass-bg-elevated: rgba(255, 255, 255, 0.15);
      --glass-border: rgba(255, 255, 255, 0.18);
      --glass-highlight: linear-gradient(135deg, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0) 50%);
      --glass-blur: blur(40px) saturate(180%);
      --glass-blur-heavy: blur(60px) saturate(200%);
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 22px;
      --radius-xl: 32px;
      --radius-full: 9999px;
      --shadow-glass-sm: 0 2px 8px rgba(0, 0, 0, 0.08);
      --shadow-glass-md: 0 8px 32px rgba(0, 0, 0, 0.12);
      --shadow-glass-lg: 0 16px 48px rgba(0, 0, 0, 0.16);
      --ease-liquid: cubic-bezier(0.4, 0, 0.2, 1);
      --duration-fast: 200ms;
      --duration-normal: 350ms;
      --duration-slow: 500ms;
      --text-primary: rgba(255, 255, 255, 0.95);
      --text-secondary: rgba(255, 255, 255, 0.6);
      --accent-blue: #007AFF;
      --accent-pink: #FF2D55;
      --accent-green: #34C759;
    }

    /* ----------------------------------------------------
       Base & Wallpaper Stage
       ---------------------------------------------------- */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body {
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: var(--text-primary);
      background-color: #0b0f19;
      background-image: 
        radial-gradient(at 10% 20%, rgba(0, 122, 255, 0.35) 0px, transparent 50%),
        radial-gradient(at 90% 15%, rgba(255, 45, 85, 0.25) 0px, transparent 45%),
        radial-gradient(at 50% 85%, rgba(52, 199, 89, 0.2) 0px, transparent 55%),
        radial-gradient(at 80% 80%, rgba(120, 60, 220, 0.3) 0px, transparent 50%);
      background-attachment: fixed;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    /* Liquid Glass Panel Standard Template */
    .glass-panel {
      background: var(--glass-bg);
      backdrop-filter: var(--glass-blur);
      -webkit-backdrop-filter: var(--glass-blur);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-glass-md);
      position: relative;
      overflow: hidden;
    }

    .glass-panel::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 50%;
      background: var(--glass-highlight);
      pointer-events: none;
      border-radius: inherit;
      z-index: 1;
    }

    /* ----------------------------------------------------
       App Container & Layout
       ---------------------------------------------------- */
    .app-viewport {
      width: 100%;
      max-width: 440px;
      height: 100vh;
      max-height: 920px;
      display: flex;
      flex-direction: column;
      position: relative;
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-glass-lg);
      border: 1px solid var(--glass-border);
      background: rgba(15, 20, 30, 0.45);
      backdrop-filter: var(--glass-blur-heavy);
      -webkit-backdrop-filter: var(--glass-blur-heavy);
      overflow: hidden;
    }

    @media (max-width: 480px) {
      .app-viewport {
        max-width: 100vw;
        max-height: 100vh;
        border-radius: 0;
        border: none;
      }
    }

    /* System Status Bar */
    .status-bar {
      height: 44px;
      padding: 0 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 14px;
      font-weight: 600;
      letter-spacing: -0.2px;
      z-index: 10;
      flex-shrink: 0;
    }

    .status-bar__icons {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Top Header Bar */
    .app-header {
      position: relative;
      z-index: 10;
      background: var(--glass-bg);
      border-bottom: 1px solid var(--glass-border);
      backdrop-filter: var(--glass-blur);
      -webkit-backdrop-filter: var(--glass-blur);
      flex-shrink: 0;
    }

    .app-header__main {
      height: 52px;
      padding: 0 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .avatar-btn {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-full);
      border: 1px solid var(--glass-border);
      background: var(--glass-bg-elevated);
      color: var(--text-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      position: relative;
      overflow: hidden;
      font-size: 13px;
      font-weight: 700;
      transition: transform var(--duration-fast) var(--ease-liquid), border-color var(--duration-fast) var(--ease-liquid);
    }

    .avatar-btn:hover {
      transform: scale(1.04);
      border-color: rgba(255, 255, 255, 0.4);
    }

    .header-logo {
      width: 26px;
      height: 26px;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .icon-btn {
      background: transparent;
      border: none;
      color: var(--text-primary);
      width: 36px;
      height: 36px;
      border-radius: var(--radius-full);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background-color var(--duration-fast) var(--ease-liquid), transform var(--duration-fast) var(--ease-liquid);
    }

    .icon-btn:hover {
      background: var(--glass-bg-elevated);
    }

    .icon-btn:focus-visible,
    .avatar-btn:focus-visible,
    .nav-item:focus-visible,
    .tab-button:focus-visible {
      outline: 2px solid var(--accent-blue);
      outline-offset: 2px;
    }

    /* Sub Tabs (For you / Following) */
    .tabs-nav {
      display: flex;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .tab-button {
      flex: 1;
      height: 46px;
      background: transparent;
      border: none;
      color: var(--text-secondary);
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color var(--duration-fast) var(--ease-liquid);
    }

    .tab-button--active {
      color: var(--text-primary);
    }

    .tab-button--active::after {
      content: '';
      position: absolute;
      bottom: 0;
      width: 56px;
      height: 3px;
      background: var(--accent-blue);
      border-radius: var(--radius-full);
    }

    /* ----------------------------------------------------
       Tweet Stream (Scrollable Main Content)
       ---------------------------------------------------- */
    .feed-container {
      flex: 1;
      overflow-y: auto;
      overflow-x: hidden;
      padding: 12px 14px 90px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      scrollbar-width: thin;
      scrollbar-color: var(--glass-border) transparent;
    }

    .feed-container::-webkit-scrollbar {
      width: 4px;
    }

    .feed-container::-webkit-scrollbar-thumb {
      background: var(--glass-border);
      border-radius: var(--radius-full);
    }

    .tweet-card {
      padding: 16px;
      transition: transform var(--duration-normal) var(--ease-liquid), background-color var(--duration-normal) var(--ease-liquid), border-color var(--duration-normal) var(--ease-liquid);
    }

    .tweet-card:hover {
      background: var(--glass-bg-elevated);
      border-color: rgba(255, 255, 255, 0.28);
      transform: translateY(-2px);
    }

    .tweet-card__inner {
      display: flex;
      gap: 12px;
      position: relative;
      z-index: 2;
    }

    .tweet-avatar {
      width: 42px;
      height: 42px;
      border-radius: var(--radius-full);
      flex-shrink: 0;
      border: 1px solid var(--glass-border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 14px;
      background: rgba(255, 255, 255, 0.12);
      color: var(--text-primary);
      text-transform: uppercase;
    }

    .tweet-avatar--ai {
      background: linear-gradient(135deg, rgba(0, 122, 255, 0.45), rgba(255, 45, 85, 0.45));
      border: 1px solid rgba(255, 255, 255, 0.35);
    }

    .tweet-content {
      flex: 1;
      min-width: 0;
    }

    .tweet-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 4px;
    }

    .tweet-header__author {
      display: flex;
      align-items: center;
      gap: 5px;
      overflow: hidden;
      white-space: nowrap;
    }

    .tweet-name {
      font-weight: 700;
      font-size: 15px;
      color: var(--text-primary);
      text-overflow: ellipsis;
      overflow: hidden;
    }

    .tweet-badge {
      display: inline-flex;
      color: var(--accent-blue);
      flex-shrink: 0;
    }

    .tweet-handle,
    .tweet-time {
      font-size: 14px;
      color: var(--text-secondary);
      flex-shrink: 0;
    }

    .tweet-more-btn {
      color: var(--text-secondary);
      background: transparent;
      border: none;
      cursor: pointer;
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-full);
      transition: color var(--duration-fast) var(--ease-liquid);
    }

    .tweet-more-btn:hover {
      color: var(--text-primary);
    }

    .tweet-text {
      font-size: 14.5px;
      line-height: 1.45;
      color: var(--text-primary);
      margin-bottom: 12px;
      word-break: break-word;
    }

    .tweet-tag {
      color: var(--accent-blue);
      text-decoration: none;
    }

    /* Embedded media panel */
    .tweet-media {
      margin-top: 10px;
      margin-bottom: 12px;
      border-radius: var(--radius-md);
      overflow: hidden;
      border: 1px solid var(--glass-border);
      background: rgba(0, 0, 0, 0.25);
      position: relative;
    }

    .media-placeholder {
      height: 160px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      color: var(--text-secondary);
      background: linear-gradient(135deg, rgba(0, 122, 255, 0.15), rgba(52, 199, 89, 0.1));
    }

    .media-placeholder span {
      font-size: 13px;
      font-weight: 500;
    }

    /* Interaction actions bar */
    .tweet-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      max-width: 320px;
      margin-top: 6px;
    }

    .action-button {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: transparent;
      border: none;
      color: var(--text-secondary);
      font-size: 12.5px;
      cursor: pointer;
      border-radius: var(--radius-full);
      padding: 6px;
      transition: color var(--duration-fast) var(--ease-liquid), transform var(--duration-fast) var(--ease-liquid);
    }

    .action-button:hover {
      color: var(--accent-blue);
      transform: scale(1.05);
    }

    .action-button--repost:hover {
      color: var(--accent-green);
    }

    .action-button--like:hover,
    .action-button--like.active {
      color: var(--accent-pink);
    }

    .action-button--like.active svg {
      fill: var(--accent-pink);
      stroke: var(--accent-pink);
    }

    /* ----------------------------------------------------
       Floating Action Button (New Tweet FAB)
       ---------------------------------------------------- */
    .fab-compose {
      position: absolute;
      right: 20px;
      bottom: 74px;
      width: 54px;
      height: 54px;
      border-radius: var(--radius-full);
      background: linear-gradient(135deg, var(--accent-blue), #2a9df4);
      border: 1px solid rgba(255, 255, 255, 0.35);
      color: #ffffff;
      box-shadow: 0 8px 24px rgba(0, 122, 255, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 20;
      transition: transform var(--duration-fast) var(--ease-liquid), box-shadow var(--duration-fast) var(--ease-liquid);
    }

    .fab-compose:hover {
      transform: scale(1.08) translateY(-2px);
      box-shadow: 0 12px 28px rgba(0, 122, 255, 0.55);
    }

    .fab-compose:active {
      transform: scale(0.96);
    }

    /* ----------------------------------------------------
       Bottom Dock Navigation
       ---------------------------------------------------- */
    .bottom-nav {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 60px;
      background: var(--glass-bg);
      backdrop-filter: var(--glass-blur);
      -webkit-backdrop-filter: var(--glass-blur);
      border-top: 1px solid var(--glass-border);
      display: flex;
      align-items: center;
      justify-content: space-around;
      padding: 0 16px;
      z-index: 15;
    }

    .nav-item {
      background: transparent;
      border: none;
      color: var(--text-secondary);
      width: 48px;
      height: 48px;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      position: relative;
      transition: color var(--duration-fast) var(--ease-liquid), transform var(--duration-fast) var(--ease-liquid);
    }

    .nav-item:hover {
      color: var(--text-primary);
      transform: translateY(-1px);
    }

    .nav-item--active {
      color: var(--text-primary);
    }

    .nav-item--active::after {
      content: '';
      position: absolute;
      bottom: 6px;
      width: 4px;
      height: 4px;
      border-radius: var(--radius-full);
      background: var(--text-primary);
    }

    .notification-dot {
      position: absolute;
      top: 10px;
      right: 12px;
      width: 7px;
      height: 7px;
      background: var(--accent-pink);
      border-radius: var(--radius-full);
      border: 1.5px solid #0b0f19;
    }

    /* Common Icon size */
    .svg-icon {
      width: 20px;
      height: 20px;
      stroke-width: 1.75;
      stroke: currentColor;
      fill: none;
      flex-shrink: 0;
    }
  </style>
</head>
<body>

  <!-- Liquid Glass App Viewport -->
  <div class="app-viewport">

    <!-- Top Status Bar (Immersion Environment) -->
    <header class="status-bar">
      <span>9:41</span>
      <div class="status-bar__icons" aria-label="System status">
        <!-- Signal -->
        <svg class="svg-icon" style="width: 15px; height: 15px;" viewBox="0 0 24 24">
          <path d="M2 20h20L12 4 2 20z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <!-- Wifi -->
        <svg class="svg-icon" style="width: 15px; height: 15px;" viewBox="0 0 24 24">
          <path d="M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <!-- Battery -->
        <svg class="svg-icon" style="width: 17px; height: 17px;" viewBox="0 0 24 24">
          <rect x="2" y="7" width="16" height="10" rx="2" ry="2"/>
          <line x1="22" y1="11" x2="22" y2="13"/>
