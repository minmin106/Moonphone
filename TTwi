      </div>
    </header>

    <!-- App Header & Timeline Tabs -->
    <header class="app-header">
      <div class="app-header__main">
        <button class="avatar-btn" aria-label="Open profile menu">
          <span>AI</span>
        </button>
        <div class="header-logo" aria-hidden="true">
          <!-- Minimalist X / Feather Style Logo -->
          <svg viewBox="0 0 24 24" class="svg-icon" style="width: 22px; height: 22px;">
            <path d="M4 4l16 16M4 20L20 4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <button class="icon-btn" aria-label="Timeline settings">
          <svg viewBox="0 0 24 24" class="svg-icon">
            <path d="M12 3v2m0 14v2M3 12h2m14 0h2m-3.5-6.5l-1.5 1.5m-10 10l-1.5 1.5m13 0l-1.5-1.5m-10-10l-1.5-1.5" stroke-linecap="round" stroke-linejoin="round"/>
